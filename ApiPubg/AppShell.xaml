<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ApiPubg.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ApiPubg"
    xmlns:view="clr-namespace:ApiPubg.Views"
    Title="ApiPubg"
    Shell.NavBarIsVisible="False">

    <FlyoutItem FlyoutDisplayOptions="AsMultipleItems">

        <ShellContent
            Title="Painel"
            ContentTemplate="{DataTemplate view:Painel}"
            Route="Painel" />

        <ShellContent Title="Partidas" ContentTemplate="{DataTemplate view:BuscarJogosView}" />

        <ShellContent Title="Telemetria" ContentTemplate="{DataTemplate view:TelemetriaView}" />

    </FlyoutItem>

</Shell>
